{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "diagnostics": {
    "globals": [
      "vim"
    ]
  },
  "Lua.diagnostics.globals": [
    "vim"
  ],
  "workspace": {
    "checkThirdParty": false,
    "library": [
      "${3rd}/luv/library",
      "${3rd}/busted/library",
      "${env:VIMRUNTIME}/lua",
      "${env:VIMRUNTIME}/lua/vim/lsp"
    ]
  },
  "telemetry": {
    "enable": false
  }
}
